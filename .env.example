# Copy to .env.local for local development. Never put the team key here (it is entered in the app).
# Address of the online sync Worker (worker/). Empty = sync off, the app works as before.
#   local test with `npm run dev` in worker/:  VITE_SYNC_URL=http://localhost:8787
VITE_SYNC_URL=
# Address printed into QR labels. Empty = the address the app is open on.
VITE_QR_BASE_URL=https://lustuder.github.io/swissinv-beta-rapid-TnT/
